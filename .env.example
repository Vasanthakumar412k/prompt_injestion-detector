# ── LLM API Keys ─────────────────────────────────────────────────────────────
# Groq reads GROQ_API_KEY from environment automatically
GROQ_API_KEY=gsk_your_groq_api_key_here
# Gemini reads GEMINI_API_KEY from environment automatically
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ── Model Selection (overrides config.py defaults) ───────────────────────────
GEMINI_MODEL=gemini-2.5-flash

# ── Application Settings ─────────────────────────────────────────────────────
# JWT Secret Key: generate with python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_long_random_secret_in_production
DATABASE_URL=sqlite:///./rag_platform.db
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL_PATH=./models/all-MiniLM-L6-v2
DEBERTA_MODEL_PATH=./models/deberta-v3-base-prompt-injection-v2
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=30
RETRIEVAL_TOP_K=5
MIN_SIMILARITY=0.45
RELATIVE_CUTOFF=0.82
MAX_CONTEXT_CHARS=12000

# ── ChromaDB Settings ────────────────────────────────────────────────────────
ANONYMIZED_TELEMETRY=False
